import json

class JsonComparator:
    def __init__(self):
        self.summary = {
            "correct": {},
            "edited": {},
            "added": {},
            "deleted": {},
            "not_available": {}
        }

    def update_summary(self, change_type, path):
        # Join the full path (all parent keys) using " -> " for tracking.
        full_path = " -> ".join(path) if path else "root"
        self.summary[change_type].setdefault(full_path, 0)
        self.summary[change_type][full_path] += 1

    def is_empty(self, val):
        # We consider only strings and lists for emptiness.
        return isinstance(val, (str, list)) and len(val) == 0

    def compare_json(self, json1, json2, level_path=None):
        if level_path is None:
            level_path = []

        # Process each key present in either JSON object.
        all_keys = set(json1.keys()).union(set(json2.keys()))
        for key in all_keys:
            current_path = level_path + [key]
            in_json1 = key in json1
            in_json2 = key in json2

            if in_json1 and in_json2:
                val1 = json1[key]
                val2 = json2[key]

                # If both values are empty (for strings or lists), record as "not_available" and skip further processing.
                if isinstance(val1, (str, list)) and self.is_empty(val1) and \
                        isinstance(val2, (str, list)) and self.is_empty(val2):
                    self.update_summary("not_available", current_path)
                    continue

                # If both values are dictionaries, compare recursively.
                if isinstance(val1, dict) and isinstance(val2, dict):
                    self.compare_json(val1, val2, current_path)

                # If both values are lists, handle based on our new rules.
                elif isinstance(val1, list) and isinstance(val2, list):
                    self.compare_lists(val1, val2, current_path)

                # For all other (primitive) types.
                else:
                    self.compare_values(val1, val2, current_path)

            else:
                # Key exists only in one JSON.
                if in_json1:
                    self.update_summary("deleted", current_path)
                else:
                    self.update_summary("added", current_path)
        return self.summary

    def compare_values(self, val1, val2, path):
        # Case for primitive values (strings, numbers, etc.)
        if val1 == val2:
            if not (isinstance(val1, (str, list)) and self.is_empty(val1)):
                self.update_summary("correct", path)
        else:
            # Handle added, deleted or edited cases for values.
            if isinstance(val1, (str, list)) and self.is_empty(val1) and \
               not (isinstance(val2, (str, list)) and self.is_empty(val2)):
                self.update_summary("added", path)
            elif not (isinstance(val1, (str, list)) and self.is_empty(val1)) and \
                 isinstance(val2, (str, list)) and self.is_empty(val2):
                self.update_summary("deleted", path)
            else:
                self.update_summary("edited", path)

    def compare_lists(self, list1, list2, path):
        max_len = max(len(list1), len(list2))
        for i in range(max_len):
            sub_path = path + [f"[{i}]"]

            # Handle missing items for different lengths
            if i >= len(list1):
                self.update_summary("added", sub_path)
                continue
            elif i >= len(list2):
                self.update_summary("deleted", sub_path)
                continue

            sub1 = list1[i]
            sub2 = list2[i]

            # If both items are lists, recursively compare the items
            if isinstance(sub1, list) and isinstance(sub2, list):
                self.compare_lists(sub1, sub2, sub_path)
            else:
                self.compare_values(sub1, sub2, sub_path)
